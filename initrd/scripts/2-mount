to_mntpt() {
	local r
	case "$1" in
	bootloader) r=/boot ;;
	esp) r=/boot/efi ;;
	userdata) r=/data ;;
	cdrom) r=/mnt/cdrom ;;
	/*) r=$1 ;;
	*) return 1 ;;
	esac
	export RESULT=$r
}

handle_fstab_line() {
	local device=$1 target=$2 # type=$3 flags=$4 vold_flags=$5

	# shellcheck disable=SC3060,SC2016
	case "$1" in
	*'$SLOT'*) if [ "$SLOT" ]; then
		local s _ss
		for s in _a _b; do
			handle_fstab_line "${1//'$SLOT'/"$s"}" "${2//'$SLOT'/"$s"}" "$3" "$4" "$5"
		done
	else
		handle_fstab_line "${1//'$SLOT'/}" "${2//'$SLOT'/}" "$3" "$4" "$5"
	fi && return $? ;;
	'$FS'*)
		device=${1//'$FS'/"/mnt/$SRC"}
		if [ -f "$device" ]; then
			handle_fstab_line "/dev/loop$(setup_loop "$device")" "$2" "$3" "$4" "$5"
		elif [ -d "$device" ]; then
			if to_mntpt "$2"; then
				mount --bind "$device" "${MODE_BASE}${RESULT}"
			else
				echo -e "WARNING: Failed to bind mount $device: No such target mountpoint!" >&2
				return 1
			fi
		fi
		return $?
		;;
	*) device=$(find_device "$1") ;;
	esac

	# Check if device is a block device
	case "$device" in
	/dev/*)
		# Get major and minor of device
		# shellcheck disable=SC2012
		echo "#>$2 $(ls -ld "$device" | awk '{print $5$6}' | tr ',' ' ')"

		if to_mntpt "$2"; then
			local _fstype="$3"
			if [ -z "$_fstype" ] || [ "$_fstype" = "auto" ]; then
				local _detected_type
				_detected_type=$(blkid -s TYPE -o value "$device" 2>/dev/null)
				[ -n "$_detected_type" ] && _fstype="$_detected_type" || _fstype="${3:-auto}"
			fi

			local _mnt_flags="${4:-defaults}"
			_mnt_flags=$(echo "$_mnt_flags" | sed -e 's/,nofail//g' -e 's/nofail,//g' -e 's/^nofail$/defaults/')

			case "$2" in
			esp|bootloader|cdrom)
				local _mgr_flags="${5:-defaults}"
				if [ "$_mgr_flags" = "defaults" ]; then
					_mgr_flags="nofail"
				elif ! echo "$_mgr_flags" | grep -q "nofail"; then
					_mgr_flags="${_mgr_flags},nofail"
				fi
				echo "/dev/block/by-name/$2 $RESULT $_fstype $_mnt_flags $_mgr_flags"
				;;
			*)
				echo "/dev/block/by-name/$2 $RESULT $_fstype $_mnt_flags ${5:-defaults}"
				;;
			esac
		fi

		case "$2" in
		"system$SLOT")
			# Keep system read-only unless rw is requested
			mount ${3:+-t "$3"} ${4:+-o "$4"} -r "$device" /android
			# Remount rw for recovery
			if [ "$RCVRY" ]; then
				mount -o remount,rw foo /android
			fi

			# Loop mount system.img
			local _img=/android/system.img
			[ -f $_img ] && mount $_img /android

			# Link libraries
			ln -sf android/system android/vendor / 2>/dev/null
			ln -sf /vendor/firmware /lib/firmware 2>/dev/null
			mkdir -p /lib/modules 2>/dev/null
			ln -sf /system/lib/modules /lib/modules/"$(uname -r)" 2>/dev/null
			;;
		*) ;;
		esac

		return $?
		;;
	*) ;;
	esac

	if [ "$3" ]; then
		# Check if device is a nodev-type filesystem
		local is_nodev
		if is_nodev=$(grep -w "$3" /proc/filesystems); then
			# Modprobe for specific filesystems if needed
			case "$3" in
			9p) modprobe 9pnet_virtio ;;
			*) ;;
			esac

			case "$is_nodev" in
			nodev*)
				to_mntpt "$2"
				echo "$1 $RESULT $3 ${4:-defaults} ${5:-defaults}"
				;;
			*) ;;
			esac
			return $?
		fi
	fi

	return 1
}

process_fstab() {
	touch /tmp/fstab.real
	local line
	while read -r line; do
		# shellcheck disable=SC2086
		case "$line" in
		'#'*) ;;
		*) handle_fstab_line $line ;;
		esac
	done </tmp/fstab.mirror >>/tmp/fstab.real
}

link_fstab() {
	ROOT_FSTAB=$(ls $MODE_BASE/fstab.* 2>/dev/null | head -1)
	[ -f "$ROOT_FSTAB" ] || return 0

	cat "$ROOT_FSTAB" >>/tmp/fstab.real
	chmod 644 /tmp/fstab.real
	mount --bind /tmp/fstab.real "$ROOT_FSTAB"
}

