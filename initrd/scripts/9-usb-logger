# usb-logger background execution
(
	find_log_partition() {
		local dev
		# 1. First priority: explicit BOOTLOG label
		dev=$(findfs LABEL=BOOTLOG 2>/dev/null)
		if [ -b "$dev" ]; then
			echo "$dev"
			return 0
		fi

		for dev in /dev/[hmnsvx][dmrv][0-9a-z]* /dev/block/*; do
			[ -b "$dev" ] || continue
			if blkid "$dev" 2>/dev/null | grep -q 'LABEL="BOOTLOG"'; then
				echo "$dev"
				return 0
			fi
		done

		# 2. Fallback: find any removable partition with supported filesystem
		for dev in /dev/sd[a-z][0-9]*; do
			[ -b "$dev" ] || continue
			[ "$dev" = "$ROOT" ] && continue
			if blkid "$dev" 2>/dev/null | grep -qE 'TYPE="(vfat|exfat|ext4)"'; then
				echo "$dev"
				return 0
			fi
		done

		# 3. Legacy size fallback (2.38 GB - 4.29 GB FAT32)
		for dev in /dev/[hmnsvx][dmrv][0-9a-z]*; do
			[ -b "$dev" ] || continue
			local devname=$(basename "$dev")
			[ -f "/sys/class/block/$devname/size" ] || continue
			local sectors=$(cat "/sys/class/block/$devname/size")
			if [ "$sectors" -gt 5000000 ] && [ "$sectors" -lt 9000000 ]; then
				if blkid "$dev" 2>/dev/null | grep -q 'TYPE="vfat"'; then
					echo "$dev"
					return 0
				fi
			fi
		done
		return 1
	}

	run_logger() {
		local log_dev=""
		for _attempt in $(seq 1 15); do
			log_dev=$(find_log_partition)
			[ -n "$log_dev" ] && break
			sleep 0.2
		done

		[ -z "$log_dev" ] && return 0

		mkdir -p /dev/usb_log
		local mounted=0
		for _fs in vfat exfat ext4; do
			if mount -t "$_fs" -o rw,noatime "$log_dev" /dev/usb_log 2>/dev/null; then
				mounted=1
				break
			fi
		done
		[ "$mounted" -eq 0 ] && mount "$log_dev" /dev/usb_log 2>/dev/null && mounted=1
		[ "$mounted" -eq 1 ] || return 0

		local mode_str="boot"
		local log_subdir="bootlogs"
		if [ -n "$RCVRY" ]; then
			mode_str="recovery"
			log_subdir="recoverylogs"
		fi

		local logdir="/dev/usb_log/$log_subdir"
		mkdir -p "$logdir" 2>/dev/null

		# Determine monotonic counter matching bootlog convention
		local cnt=0
		[ -f "$logdir/.counter" ] && cnt=$(cat "$logdir/.counter" 2>/dev/null)
		cnt=$((cnt + 1))
		echo "$cnt" > "$logdir/.counter" 2>/dev/null

		local ts=$(date +%Y%m%d-%H%M%S 2>/dev/null)
		[ -z "$ts" ] && ts="00000000-000000"
		local session_name=$(printf '%s%04d' "$mode_str" "$cnt")
		local tag=$(printf '%s-%s' "$session_name" "$ts")
		local session_dir="$logdir/$session_name"
		mkdir -p "$session_dir" 2>/dev/null

		# Save current session and tag for userspace continuation
		echo "$session_name" > "$logdir/.current_session" 2>/dev/null
		echo "$tag" > "$logdir/.current_tag" 2>/dev/null

		echo "==== $mode_str $tag dev=$log_dev uptime=$(cat /proc/uptime 2>/dev/null) ====" > "$session_dir/$tag-info.txt"

		# Initial fast capture
		[ -f /tmp/log ] && cp /tmp/log "$session_dir/$tag-early-initrd.log" 2>/dev/null
		dmesg > "$session_dir/$tag-dmesg-early.txt" 2>&1
		dmesg > "$session_dir/$tag-dmesg.txt" 2>&1

		# Also write root-level log files for quick inspection
		echo "=== USB LOGGER STARTED AT $(date) (tag: $tag, mode: $mode_str, dev: $log_dev) ===" > /dev/usb_log/usb_logger_status.txt
		dmesg > /dev/usb_log/dmesg.txt 2>&1
		[ -f /tmp/log ] && cp /tmp/log /dev/usb_log/early_boot_log.txt 2>/dev/null

		dmesg > "$logdir/${mode_str}-latest-dmesg.txt" 2>&1
		[ -f /tmp/log ] && cp /tmp/log "$logdir/${mode_str}-latest-initrd.log" 2>/dev/null
		sync

		# Continuous fast logging loop
		while true; do
			dmesg > "$session_dir/$tag-dmesg.txt" 2>&1
			dmesg > "$logdir/${mode_str}-latest-dmesg.txt" 2>&1
			dmesg > /dev/usb_log/dmesg.txt 2>&1
			[ -f /tmp/log ] && cp /tmp/log "$session_dir/$tag-early-initrd.log" 2>/dev/null

			if which logcat >/dev/null 2>&1; then
				logcat -d > "$session_dir/$tag-logcat.txt" 2>&1
				logcat -d > "$logdir/${mode_str}-latest-logcat.txt" 2>&1
				logcat -d > /dev/usb_log/logcat.txt 2>&1
			elif [ -x /system/bin/logcat ]; then
				/system/bin/logcat -d > "$session_dir/$tag-logcat.txt" 2>&1
				/system/bin/logcat -d > "$logdir/${mode_str}-latest-logcat.txt" 2>&1
				/system/bin/logcat -d > /dev/usb_log/logcat.txt 2>&1
			fi

			sync
			sleep 1
		done
	}

	run_logger
) &
