setup_recovery() {
  [ "$RCVRY" ] || return 0

  local rec_img=""
  if [ -n "$SLOT" ] && [ -e "/mnt/$SRC/recovery$SLOT.img" ]; then
    rec_img="/mnt/$SRC/recovery$SLOT.img"
  elif [ -e "/mnt/$SRC/recovery.img" ]; then
    rec_img="/mnt/$SRC/recovery.img"
  elif [ -e "/mnt/$SRC/ramdisk-recovery.img" ]; then
    rec_img="/mnt/$SRC/ramdisk-recovery.img"
  fi

  if [ -z "$rec_img" ]; then
    echo "WARNING: No recovery image found (checked recovery$SLOT.img, recovery.img, ramdisk-recovery.img)"
    return 1
  fi

  mkdir -p /recovery
  mount -t tmpfs -o mode=0755,rw tmpfs /recovery
  zcat "$rec_img" | (
    cd /recovery
    cpio -iud >/dev/null
  )

  mkdir -p /recovery/bin 2>/dev/null
  cp /bin/busybox /recovery/bin/busybox 2>/dev/null
  chmod 755 /recovery/bin/busybox 2>/dev/null

  export REAL_FSTAB=/recovery/system/etc/recovery.fstab
}

probe_recovery() {
  [ ! "$RCVRY" ] && [ ! "$RCVRY_PROBE" ] && return 0

  echo "Detecting hardware for recovery..."
  busybox modprobe -a hid-apple
  auto_detect_recovery &
  sleep 2
}

mount_recovery() {
  [ "$RCVRY" ] || return 0

  if [ -d /recovery/data/cache ]; then
    ln -s /data/cache /recovery/cache
  fi
}

post_setup_recovery() {
  [ "$RCVRY" ] || return 0

  umount -f /android
}
